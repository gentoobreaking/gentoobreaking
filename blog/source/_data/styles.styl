// 文章卡片圓角化
.post-block {
  border-radius: 12px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  margin-bottom: 24px;
  padding: 40px;
}

// 側邊欄圓角化
.sidebar-inner {
  border-radius: 12px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

// 標題加粗
.post-title {
  font-weight: 700;
  color: #1e293b;
}

// 頂部導覽列優化
.header-inner {
  border-radius: 0 0 12px 12px;
}

// 按鈕美化
.btn {
  border-radius: 6px;
  transition: all 0.3s ease;
}

// Dark theme overrides for post content
.post-content {
  .ai-response {
    border-left: 3px solid #334155;
    padding: 16px 24px;
    margin: 20px 0;
    background: #1e293b;
    border-radius: 0 8px 8px 0;
  }
  .poison-reason,
  .adjust-tips {
    li {
      margin-bottom: 12px;
      line-height: 1.6;
    }
  }
  h1, h2 {
    color: #f8fafc;
    margin-top: 28px;
    margin-bottom: 16px;
    border-bottom: 1px solid #334155;
    padding-bottom: 8px;
  }
  h1 {
    border-bottom: 2px solid #334155;
  }
  h3 {
    color: #cbd5e1;
    margin-top: 24px;
    margin-bottom: 12px;
  }
  code {
    background: #334155;
    padding: 2px 6px;
    border-radius: 4px;
    color: #fbbf24;
  }
  pre {
    code {
      background: #0f172a;
      padding: 0;
    }
  }
  table {
    background: #0f172a;
    tr {
      background: #0f172a;
      &:nth-child(odd) {
        background: #0f172a;
      }
      &:hover {
        background: #0f172a;
      }
    }
    th, td {
      background: transparent;
      color: #e2e8f0;
    }
  }
}
